# Africa's Talking credentials
# Get these from https://account.africastalking.com/
AT_API_KEY=your_api_key_here
AT_USERNAME=sandbox
AT_ENVIRONMENT=sandbox

# Postgres connection
POSTGRES_USER=notmysim
POSTGRES_PASSWORD=notmysim_secret
POSTGRES_DB=notmysim
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Server config
PORT=8080

# Risk window duration (how long after a swap we consider events high-risk)
RISK_WINDOW_HOURS=72

# SMS alert — number to notify when fraud is detected (E.164 format, e.g. +254712345678)
ALERT_SMS_FROM=+254712345678

# Demo/pitch safety: redirect all 2FA SMS alerts to this number instead of the victim's number.
# Set this to the presenter's phone so the audience sees a live SMS land on one phone.
# Leave empty to send to the actual victim number (only do this in true production).
DEMO_ALERT_PHONE=

# Analyst/admin phone — receives a summary SMS whenever NEUTRALIZE NETWORK is clicked.
# Leave empty to only log the takedown locally.
ALERT_PHONE=
