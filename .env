# Africa's Talking credentials
# Get these from https://account.africastalking.com/
AT_API_KEY=
AT_USERNAME=
AT_ENVIRONMENT=production

# Postgres connection
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Server config
PORT=8089

# Risk window duration (how long after a swap we consider events high-risk)
RISK_WINDOW_HOURS=72

# SMS alert — number to notify when fraud is detected (E.164 format, e.g. +254712345678)
ALERT_SMS_FROM=+254712345678

AT_SMS_SHORTCODE=AFTKNG
# AT_VOICE_NUMBER=+254711082000   # ← not yet provisioned — ask hackathon lead to assign a voice number


DEMO_ALERT_PHONE=+254xxxxxxxx

# Analyst/admin phone — receives a summary SMS whenever NEUTRALIZE NETWORK is clicked.
# Set this to the security analyst's number. Leave blank to only log the takedown.
ALERT_PHONE=+254xxxxxxxx
